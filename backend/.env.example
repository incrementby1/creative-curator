# Optional: Supabase persistence
# If unset, the backend runs fully in-memory (sessions reset when the API restarts).

# Your project URL (Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Recommended for backend servers (bypasses RLS):
# SUPABASE_SERVICE_ROLE_KEY=

# For quick demos you can use the anon key, but then your DB policies matter.
SUPABASE_ANON_KEY=your_anon_key
