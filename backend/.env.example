# Optional local Supabase persistence. If these are unset, the backend runs
# fully in-memory and sessions reset when the API restarts.
#
# Start the local stack first, then copy its local API URL and anon key from:
#   supabase status -o env
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<local-anon-key-from-supabase-status>

# A local service-role key is also supported for backend-only demos:
# SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-from-supabase-status>
