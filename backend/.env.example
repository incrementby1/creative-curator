# Local-only persistent development. Copy this file to ignored `.env.local`,
# then replace placeholders with values from `supabase status -o env`.
APP_ENV=development
AUTH_MODE=supabase
SETTINGS_STORE_MODE=supabase
LLM_TRANSPORT_MODE=live
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
BYOK_MASTER_KEY=replace-with-base64-encoded-32-byte-local-key
